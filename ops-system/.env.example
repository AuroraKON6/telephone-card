# 172 Haoka AI ops env template.
# Copy to .env and fill real keys later. Do not commit real secrets.

APP_ENV=local
TIMEZONE=Asia/Shanghai

# Runtime: interactive / openclaw / claudecode
AI_OPS_RUNTIME=interactive

# OpenClaw
OPENCLAW_PROJECT=172-haoka-ai-ops
OPENCLAW_CONFIG=./openclaw/openclaw.yaml
OPENCLAW_MEMORY_DIR=./openclaw/memory
OPENCLAW_LOG_DIR=./logs

# ClaudeCode. Leave CLAUDECODE_ROOT empty to auto-detect the installed local folder.
CLAUDECODE_ROOT=
CLAUDECODE_SETTINGS_OUT=./claudecode/settings.selected.json
CLAUDECODE_SYSTEM_PROMPT=./claudecode/CLAUDECODE_SYSTEM_PROMPT.md

# Local customer model: RTX4060 + Qwen 3.5 9B via local OpenAI-compatible endpoint.
CUSTOMER_MODEL_PROVIDER=local_openai_compatible
CUSTOMER_MODEL_NAME=qwen3.5-9b-local
CUSTOMER_MODEL_BASE_URL=http://127.0.0.1:11434/v1
CUSTOMER_MODEL_API_KEY=ollama
CUSTOMER_MODEL_CONTEXT=4096

# Marketing API is selected by start-ai-ops.ps1.
MARKETING_API_PROVIDER=interactive
MARKETING_MODEL_PROVIDER=openai_compatible
MARKETING_MODEL_NAME=
MARKETING_MODEL_BASE_URL=
MARKETING_MODEL_API_KEY=
MARKETING_MODEL_TIMEOUT_SECONDS=90

# DeepSeek V4 Flash placeholder.
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_THINKING_ENABLED=true
DEEPSEEK_API_KEY=

# Mimo V2.5 Pro placeholder.
MIMO_BASE_URL=https://token-plan-sgp.xiaomimimo.com/v1
MIMO_MODEL=mimoV2.5pro
MIMO_API_KEY=

# 172 official API placeholder. Keep disabled until credentials and callback are ready.
API_172_ENABLED=false
API_172_BASE_URL=https://haokaopenapi.lot-ml.com
API_172_USER_ID=
API_172_SECRET=
API_172_CALLBACK_PUBLIC_URL=

# Learning and approval.
LEARNING_WEB_CRAWL_ENABLED=true
LEARNING_RATE_LIMIT_PER_DOMAIN_PER_HOUR=20
LEARNING_REQUIRE_ROBOTS_TXT=true
HUMAN_APPROVAL_REQUIRED=true
APPROVAL_INBOX=./handoff/approval-inbox.md
