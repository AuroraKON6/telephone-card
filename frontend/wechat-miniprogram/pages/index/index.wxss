/* pages/index/index.wxss */

/* ===== Page Root ===== */
.page-root {
  position: relative;
  min-height: 100vh;
  background:
    linear-gradient(110deg, rgba(28, 79, 183, 0.08), transparent 36%),
    radial-gradient(circle at 82% 12%, rgba(201, 161, 90, 0.16), transparent 28%),
    linear-gradient(180deg, #f6f7fb, #fbfaf7);
  overflow-x: hidden;
}

/* ===== Ambient ===== */
.ambient {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 0;
  pointer-events: none;
  overflow: hidden;
}

.beam {
  position: absolute;
  width: 960rpx;
  height: 960rpx;
  border-radius: 999rpx;
  filter: blur(120rpx);
  opacity: 0.42;
}

.beam-a {
  right: -240rpx;
  top: 80rpx;
  background: rgba(28, 79, 183, 0.22);
}

.beam-b {
  left: -360rpx;
  bottom: -360rpx;
  background: rgba(201, 161, 90, 0.18);
}

.grain {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  opacity: 0.12;
  background-image:
    linear-gradient(rgba(20, 25, 34, 0.06) 1rpx, transparent 1rpx),
    linear-gradient(90deg, rgba(20, 25, 34, 0.045) 1rpx, transparent 1rpx);
  background-size: 72rpx 72rpx;
}

/* ===== Header ===== */
.site-header {
  position: sticky;
  top: 0;
  z-index: 30;
  display: flex;
  align-items: center;
  padding: 0 32rpx;
  min-height: 152rpx;
  background: rgba(246, 247, 251, 0.82);
  border-bottom: 1rpx solid rgba(32, 43, 68, 0.14);
  backdrop-filter: blur(44rpx) saturate(1.18);
}

.brand {
  display: flex;
  align-items: center;
  gap: 24rpx;
}

.brand-sigil {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 84rpx;
  height: 84rpx;
  color: #fff;
  background: linear-gradient(150deg, #0d275d, #1c4fb7);
  border: 2rpx solid rgba(255, 255, 255, 0.32);
  border-radius: 16rpx;
  font-family: Georgia, "Times New Roman", serif;
  font-size: 28rpx;
  font-weight: 800;
  box-shadow: 0 12rpx 30rpx rgba(23, 33, 55, 0.1);
}

.brand-text {
  display: flex;
  flex-direction: column;
}

.brand-name {
  font-size: 38rpx;
  font-weight: 760;
  letter-spacing: -0.02em;
  color: #151821;
}

.brand-sub {
  font-size: 22rpx;
  color: #7d8798;
  letter-spacing: 0.08em;
  text-transform: uppercase;
}

/* ===== Overline ===== */
.overline {
  display: block;
  color: #1c4fb7;
  font-size: 24rpx;
  font-weight: 850;
  letter-spacing: 0.12em;
  text-transform: uppercase;
}

/* ===== Hero ===== */
.hero {
  position: relative;
  z-index: 1;
  padding: 60rpx 32rpx 80rpx;
}

.hero-copy {
  margin-bottom: 48rpx;
}

.hero-title {
  display: block;
  margin-top: 36rpx;
  font-size: 64rpx;
  line-height: 1.08;
  letter-spacing: -0.055em;
  font-weight: 760;
  color: #151821;
}

.hero-lead {
  display: block;
  margin-top: 32rpx;
  font-size: 32rpx;
  color: #394254;
  line-height: 1.6;
}

.hero-actions {
  display: flex;
  flex-wrap: wrap;
  gap: 24rpx;
  margin-top: 48rpx;
}

.button {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 96rpx;
  padding: 0 44rpx;
  border-radius: 16rpx;
  font-weight: 760;
  font-size: 30rpx;
}

.button.primary {
  color: #fff;
  background: linear-gradient(135deg, #0d275d, #1c4fb7);
  box-shadow: 0 36rpx 68rpx rgba(28, 79, 183, 0.22);
}

.button.quiet {
  color: #151821;
  background: rgba(255, 255, 255, 0.76);
  border: 2rpx solid rgba(32, 43, 68, 0.14);
}

/* Hero Ledger */
.hero-ledger {
  display: flex;
  gap: 20rpx;
  margin-top: 48rpx;
}

.ledger-item {
  flex: 1;
  padding: 28rpx 32rpx;
  background: rgba(255, 255, 255, 0.76);
  border: 2rpx solid rgba(32, 43, 68, 0.14);
  border-radius: 16rpx;
  box-shadow: 0 12rpx 30rpx rgba(23, 33, 55, 0.1);
}

.ledger-label {
  display: block;
  font-size: 24rpx;
  color: #7d8798;
}

.ledger-count {
  display: block;
  font-family: Georgia, "Times New Roman", serif;
  font-size: 56rpx;
  line-height: 1.1;
  letter-spacing: -0.04em;
  color: #151821;
  margin-top: 4rpx;
}

.ledger-note {
  display: block;
  font-size: 22rpx;
  color: #7d8798;
  margin-top: 2rpx;
}

/* ===== Mascot Stage ===== */
.mascot-stage {
  position: relative;
  perspective: 2400rpx;
}

.mascot-card {
  position: relative;
  padding: 32rpx;
  background:
    linear-gradient(180deg, rgba(255, 255, 255, 0.86), rgba(238, 244, 255, 0.78)),
    rgba(255, 255, 255, 0.76);
  border: 2rpx solid rgba(32, 43, 68, 0.14);
  border-radius: 24rpx;
  box-shadow: 0 48rpx 160rpx rgba(23, 33, 55, 0.12);
  overflow: hidden;
}

.mascot-toolbar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  min-height: 80rpx;
  padding: 0 24rpx;
  background: rgba(255, 255, 255, 0.52);
  border: 2rpx solid rgba(32, 43, 68, 0.14);
  border-radius: 16rpx;
  font-size: 24rpx;
  font-weight: 800;
  color: #394254;
  backdrop-filter: blur(24rpx);
}

.toolbar-gaze {
  color: #1c4fb7;
}

/* Mascot Portrait */
.mascot-portrait {
  position: relative;
  height: 900rpx;
  margin-top: 24rpx;
  overflow: hidden;
  border-radius: 16rpx;
  background:
    linear-gradient(rgba(28, 79, 183, 0.09) 1rpx, transparent 1rpx),
    linear-gradient(90deg, rgba(28, 79, 183, 0.08) 1rpx, transparent 1rpx),
    radial-gradient(circle at 50% 28%, rgba(28, 79, 183, 0.12), transparent 44%),
    linear-gradient(180deg, #fbfaf7, #eef4ff);
  background-size: 68rpx 68rpx, 68rpx 68rpx, auto, auto;
  border: 2rpx solid rgba(32, 43, 68, 0.14);
  isolation: isolate;
}

.mascot-img {
  position: absolute;
  left: 50%;
  bottom: 20rpx;
  width: auto;
  height: calc(100% - 56rpx);
  max-width: none;
  transform-origin: 50% 72%;
  transition: transform 120ms ease-out;
  margin-left: -200rpx;
  width: 400rpx;
}

.mascot-portrait.mascot-tap .mascot-img {
  animation: mascotTap 520ms cubic-bezier(0.16, 1, 0.3, 1);
}

@keyframes mascotTap {
  0%, 100% { transform: scale(1); }
  45% { transform: scale(1.018); }
}

/* Portrait Rings */
.portrait-ring {
  position: absolute;
  left: 50%;
  top: 48%;
  border: 2rpx solid rgba(28, 79, 183, 0.32);
  border-radius: 50%;
  transform: translate(-50%, -50%);
  pointer-events: none;
}

.ring-one {
  width: 78%;
  aspect-ratio: 1;
  animation: ringSpin 28s linear infinite;
}

.ring-two {
  width: 58%;
  aspect-ratio: 1;
  border-color: rgba(201, 161, 90, 0.44);
  animation: ringSpin 36s linear infinite reverse;
}

@keyframes ringSpin {
  to { transform: translate(-50%, -50%) rotate(360deg); }
}

/* Eye Glint */
.eye-glint {
  position: absolute;
  z-index: 4;
  width: 22rpx;
  height: 22rpx;
  background: rgba(255, 255, 255, 0.88);
  border-radius: 50%;
  box-shadow: 0 0 32rpx rgba(255, 255, 255, 0.95);
  opacity: 0.72;
  pointer-events: none;
  transition: transform 120ms ease-out;
}

.eye-left {
  left: 46.5%;
  top: 26.5%;
}

.eye-right {
  left: 55.3%;
  top: 26.2%;
}

/* ===== Expression Layer ===== */
.expression-layer {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 5;
  pointer-events: none;
  transition: transform 120ms ease-out;
}

.face-brow,
.face-mouth,
.blush,
.anger-mark,
.mood-sparkle {
  position: absolute;
  opacity: 0;
  transition: opacity 180ms ease, transform 220ms cubic-bezier(0.16, 1, 0.3, 1);
}

/* Brows */
.face-brow {
  top: 24.5%;
  width: 60rpx;
  height: 10rpx;
  background: #18213a;
  border-radius: 999rpx;
  box-shadow: 0 2rpx 0 rgba(255, 255, 255, 0.42);
}

.brow-left {
  left: calc(50% - 100rpx);
}

.brow-right {
  left: calc(50% + 40rpx);
}

/* Mouth */
.face-mouth {
  left: calc(50% - 28rpx);
  top: 33%;
  width: 64rpx;
  height: 32rpx;
  border: 6rpx solid #82405a;
  border-top: 0;
  border-left-color: transparent;
  border-right-color: transparent;
  border-radius: 0 0 999rpx 999rpx;
}

/* Blush */
.blush {
  top: 30.4%;
  width: 60rpx;
  height: 24rpx;
  background: repeating-linear-gradient(100deg, rgba(217, 101, 128, 0.82) 0 4rpx, transparent 4rpx 16rpx);
  border-radius: 999rpx;
  filter: blur(0.4rpx);
}

.blush-left {
  left: calc(50% - 144rpx);
  transform: rotate(-8deg);
}

.blush-right {
  left: calc(50% + 88rpx);
  transform: rotate(8deg);
}

/* Anger Mark */
.anger-mark {
  left: calc(50% + 144rpx);
  top: 21%;
  width: 68rpx;
  height: 68rpx;
}

.anger-i {
  position: absolute;
  width: 30rpx;
  height: 8rpx;
  background: #b95a73;
  border-radius: 999rpx;
  transform-origin: center;
}

.anger-i1 { left: 4rpx; top: 16rpx; transform: rotate(-42deg); }
.anger-i2 { left: 32rpx; top: 16rpx; transform: rotate(42deg); }
.anger-i3 { left: 6rpx; top: 42rpx; transform: rotate(42deg); }
.anger-i4 { left: 32rpx; top: 42rpx; transform: rotate(-42deg); }

/* Sparkles */
.mood-sparkle {
  width: 24rpx;
  height: 24rpx;
  color: #c9a15a;
}

.mood-sparkle::before,
.mood-sparkle::after {
  content: "";
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  margin: auto;
  background: currentColor;
  border-radius: 999rpx;
}

.mood-sparkle::before {
  width: 4rpx;
  height: 24rpx;
}

.mood-sparkle::after {
  width: 24rpx;
  height: 4rpx;
}

.sparkle-a {
  left: calc(50% - 216rpx);
  top: 20%;
}

.sparkle-b {
  left: calc(50% + 192rpx);
  top: 29%;
  transform: scale(0.8);
}

.sparkle-c {
  left: calc(50% - 184rpx);
  top: 37%;
  transform: scale(0.65);
}

/* ===== Expression States (Smile) ===== */
.expression-layer .face-mouth.smile,
.expression-layer .blush.smile,
.expression-layer .mood-sparkle.smile {
  opacity: 1;
}

.expression-layer .face-mouth.smile {
  transform: translateY(4rpx) scale(1.08);
}

.expression-layer .blush.smile {
  animation: blushPulse 1.4s ease-in-out infinite;
}

.expression-layer .mood-sparkle.smile {
  animation: sparklePop 1.1s ease-in-out infinite;
}

.expression-layer .sparkle-b.smile {
  animation-delay: 150ms;
}

.expression-layer .sparkle-c.smile {
  animation-delay: 320ms;
}

@keyframes blushPulse {
  50% { opacity: 0.62; }
}

@keyframes sparklePop {
  0%, 100% { transform: scale(0.6) rotate(0deg); }
  50% { transform: scale(1.2) rotate(90deg); }
}

/* ===== Expression States (Tsundere) ===== */
.expression-layer .face-brow.tsundere,
.expression-layer .face-mouth.tsundere,
.expression-layer .blush.tsundere,
.expression-layer .anger-mark.tsundere {
  opacity: 1;
}

.expression-layer .brow-left.tsundere {
  transform: translateY(-4rpx) rotate(16deg);
}

.expression-layer .brow-right.tsundere {
  transform: translateY(-4rpx) rotate(-16deg);
}

.expression-layer .face-mouth.tsundere {
  top: 34.5%;
  width: 52rpx;
  height: 14rpx;
  border-top: 6rpx solid #82405a;
  border-bottom: 0;
  border-left-color: transparent;
  border-right-color: transparent;
  border-radius: 999rpx 999rpx 0 0;
  transform: translateX(6rpx) rotate(-6deg);
}

.expression-layer .blush.tsundere {
  background: repeating-linear-gradient(100deg, rgba(185, 90, 115, 0.74) 0 4rpx, transparent 4rpx 16rpx);
}

.expression-layer .anger-mark.tsundere {
  animation: angerBeat 760ms ease-in-out infinite;
}

@keyframes angerBeat {
  50% { transform: scale(1.14) rotate(4deg); }
}

/* Mascot Dialog */
.mascot-dialog {
  display: flex;
  align-items: center;
  gap: 20rpx;
  margin-top: 24rpx;
  padding: 28rpx 32rpx;
  color: #394254;
  background: rgba(255, 255, 255, 0.76);
  border: 2rpx solid rgba(32, 43, 68, 0.14);
  border-radius: 16rpx;
  font-size: 30rpx;
  box-shadow: 0 12rpx 30rpx rgba(23, 33, 55, 0.1);
}

.pulse-dot {
  width: 16rpx;
  height: 16rpx;
  flex-shrink: 0;
  background: #237c5b;
  border-radius: 50%;
  box-shadow: 0 0 0 14rpx rgba(35, 124, 91, 0.18);
}

.dialog-text {
  flex: 1;
  line-height: 1.5;
}

/* Floating Notes */
.floating-note {
  position: relative;
  margin-top: 20rpx;
  padding: 26rpx 30rpx;
  background: rgba(255, 255, 255, 0.82);
  border: 2rpx solid rgba(32, 43, 68, 0.14);
  border-radius: 16rpx;
  box-shadow: 0 12rpx 30rpx rgba(23, 33, 55, 0.1);
  backdrop-filter: blur(28rpx);
}

.note-label {
  display: block;
  font-size: 24rpx;
  color: #7d8798;
}

.note-value {
  display: block;
  margin-top: 6rpx;
  font-size: 36rpx;
  color: #151821;
  font-weight: 600;
}

/* ===== Section Common ===== */
.section-heading {
  max-width: 100%;
}

.section-heading.compact {
  max-width: 100%;
}

.section-title {
  display: block;
  margin-top: 16rpx;
  font-size: 52rpx;
  line-height: 1.12;
  letter-spacing: -0.04em;
  font-weight: 760;
  color: #151821;
}

.section-desc {
  display: block;
  margin-top: 20rpx;
  font-size: 30rpx;
  color: #394254;
  line-height: 1.5;
}

/* ===== Plans Section ===== */
.plans-section {
  position: relative;
  z-index: 1;
  padding: 80rpx 32rpx;
}

.segment-control {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-top: 48rpx;
}

.seg-btn {
  min-height: 76rpx;
  padding: 0 30rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #394254;
  background: rgba(255, 255, 255, 0.76);
  border: 2rpx solid rgba(32, 43, 68, 0.14);
  border-radius: 16rpx;
  font-size: 28rpx;
  font-weight: 760;
}

.seg-btn.active {
  color: #fff;
  background: #1c4fb7;
  border-color: #1c4fb7;
}

.plan-gallery {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
  margin-top: 32rpx;
}

.plan-card {
  position: relative;
  padding: 40rpx;
  overflow: hidden;
  background: rgba(255, 255, 255, 0.76);
  border: 2rpx solid rgba(32, 43, 68, 0.14);
  border-radius: 16rpx;
  box-shadow: 0 12rpx 30rpx rgba(23, 33, 55, 0.1);
}

.plan-card::before {
  content: "";
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  pointer-events: none;
}

.plan-tone-blue { --accent: #1c4fb7; }
.plan-tone-gold { --accent: #c9a15a; }
.plan-tone-cyan { --accent: #0f8fa5; }
.plan-tone-rose { --accent: #b95a73; }

.plan-card::before {
  background:
    radial-gradient(circle at 78% 12%, rgba(var(--accent-rgb, 28, 79, 183), 0.24), transparent 30%),
    linear-gradient(180deg, transparent, rgba(var(--accent-rgb, 28, 79, 183), 0.08));
}

.plan-tone-blue::before {
  background:
    radial-gradient(circle at 78% 12%, rgba(28, 79, 183, 0.24), transparent 30%),
    linear-gradient(180deg, transparent, rgba(28, 79, 183, 0.08));
}

.plan-tone-gold::before {
  background:
    radial-gradient(circle at 78% 12%, rgba(201, 161, 90, 0.24), transparent 30%),
    linear-gradient(180deg, transparent, rgba(201, 161, 90, 0.08));
}

.plan-tone-cyan::before {
  background:
    radial-gradient(circle at 78% 12%, rgba(15, 143, 165, 0.24), transparent 30%),
    linear-gradient(180deg, transparent, rgba(15, 143, 165, 0.08));
}

.plan-tone-rose::before {
  background:
    radial-gradient(circle at 78% 12%, rgba(185, 90, 115, 0.24), transparent 30%),
    linear-gradient(180deg, transparent, rgba(185, 90, 115, 0.08));
}

.plan-card > * {
  position: relative;
  z-index: 1;
}

.plan-label {
  display: inline-flex;
  align-items: center;
  min-height: 56rpx;
  padding: 0 20rpx;
  font-size: 24rpx;
  font-weight: 850;
  border-radius: 999rpx;
}

.plan-tone-blue .plan-label { color: #1c4fb7; background: rgba(28, 79, 183, 0.12); border: 2rpx solid rgba(28, 79, 183, 0.22); }
.plan-tone-gold .plan-label { color: #c9a15a; background: rgba(201, 161, 90, 0.12); border: 2rpx solid rgba(201, 161, 90, 0.22); }
.plan-tone-cyan .plan-label { color: #0f8fa5; background: rgba(15, 143, 165, 0.12); border: 2rpx solid rgba(15, 143, 165, 0.22); }
.plan-tone-rose .plan-label { color: #b95a73; background: rgba(185, 90, 115, 0.12); border: 2rpx solid rgba(185, 90, 115, 0.22); }

.plan-name {
  display: block;
  margin-top: 32rpx;
  font-size: 42rpx;
  font-weight: 700;
  line-height: 1.2;
  color: #151821;
}

.plan-fit {
  display: block;
  margin-top: 12rpx;
  font-size: 28rpx;
  color: #7d8798;
  min-height: 84rpx;
}

.plan-price {
  display: flex;
  align-items: baseline;
  gap: 12rpx;
  margin-top: 28rpx;
}

.price-num {
  font-family: Georgia, "Times New Roman", serif;
  font-size: 88rpx;
  line-height: 0.95;
  font-weight: 700;
}

.plan-tone-blue .price-num { color: #1c4fb7; }
.plan-tone-gold .price-num { color: #c9a15a; }
.plan-tone-cyan .price-num { color: #0f8fa5; }
.plan-tone-rose .price-num { color: #b95a73; }

.price-unit {
  font-size: 26rpx;
  color: #7d8798;
}

.plan-specs {
  margin-top: 32rpx;
}

.spec-row {
  display: flex;
  justify-content: space-between;
  gap: 24rpx;
  padding-top: 16rpx;
  border-top: 2rpx solid rgba(32, 43, 68, 0.14);
  font-size: 26rpx;
}

.spec-key {
  color: #7d8798;
}

.spec-val {
  color: #151821;
  font-weight: 600;
  text-align: right;
}

/* ===== Precheck Section ===== */
.precheck-section {
  position: relative;
  z-index: 1;
  padding: 0 32rpx 80rpx;
}

.precheck-panel {
  padding: 48rpx;
  background: rgba(255, 255, 255, 0.76);
  border: 2rpx solid rgba(32, 43, 68, 0.14);
  border-radius: 20rpx;
  box-shadow: 0 48rpx 160rpx rgba(23, 33, 55, 0.12);
}

.precheck-form {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
  margin-top: 40rpx;
}

.form-field {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.field-label {
  font-size: 26rpx;
  font-weight: 780;
  color: #394254;
}

.field-input {
  min-height: 88rpx;
  width: 100%;
  padding: 0 26rpx;
  color: #151821;
  background: rgba(238, 244, 255, 0.68);
  border: 2rpx solid rgba(32, 43, 68, 0.14);
  border-radius: 10rpx;
  font-size: 30rpx;
  display: flex;
  align-items: center;
}

.picker-display {
  flex-direction: row;
  justify-content: space-between;
}

.picker-arrow {
  color: #7d8798;
  font-size: 24rpx;
}

.precheck-result {
  margin-top: 28rpx;
  padding: 30rpx 32rpx;
  background: rgba(238, 244, 255, 0.72);
  border: 2rpx solid rgba(32, 43, 68, 0.14);
  border-radius: 16rpx;
}

.result-title {
  display: block;
  font-size: 30rpx;
  font-weight: 700;
}

.result-desc {
  display: block;
  margin-top: 8rpx;
  font-size: 28rpx;
  color: #7d8798;
  line-height: 1.5;
}

.precheck-result.idle {
  color: #394254;
}

.precheck-result.ready {
  color: #237c5b;
  background: rgba(35, 124, 91, 0.1);
  border-color: rgba(35, 124, 91, 0.24);
}

.precheck-result.warn {
  color: #a56c17;
  background: rgba(165, 108, 23, 0.12);
  border-color: rgba(165, 108, 23, 0.28);
}

.precheck-result.danger {
  color: #b34637;
  background: rgba(179, 70, 55, 0.1);
  border-color: rgba(179, 70, 55, 0.26);
}

/* ===== Agent Section ===== */
.agent-section {
  position: relative;
  z-index: 1;
  padding: 0 32rpx 80rpx;
}

.agent-panel {
  padding: 48rpx;
  background: rgba(255, 255, 255, 0.76);
  border: 2rpx solid rgba(32, 43, 68, 0.14);
  border-radius: 20rpx;
  box-shadow: 0 48rpx 160rpx rgba(23, 33, 55, 0.12);
}

.chat-log {
  height: 560rpx;
  margin-top: 36rpx;
  padding: 32rpx;
  background:
    linear-gradient(rgba(28, 79, 183, 0.06) 1rpx, transparent 1rpx),
    linear-gradient(90deg, rgba(28, 79, 183, 0.05) 1rpx, transparent 1rpx),
    rgba(238, 244, 255, 0.66);
  background-size: 56rpx 56rpx;
  border: 2rpx solid rgba(32, 43, 68, 0.14);
  border-radius: 16rpx;
}

.message {
  max-width: 82%;
  padding: 24rpx 28rpx;
  border-radius: 16rpx;
  font-size: 28rpx;
  margin-bottom: 20rpx;
  line-height: 1.5;
  animation: messageIn 220ms ease both;
}

@keyframes messageIn {
  from { opacity: 0; transform: translateY(12rpx); }
}

.message.assistant {
  align-self: flex-start;
  color: #394254;
  background: #ffffff;
  border: 2rpx solid rgba(32, 43, 68, 0.14);
}

.message.user {
  align-self: flex-end;
  color: #fff;
  background: #1c4fb7;
  margin-left: auto;
}

.quick-replies {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-top: 24rpx;
}

.quick-btn {
  min-height: 72rpx;
  padding: 0 28rpx;
  display: flex;
  align-items: center;
  color: #394254;
  background: rgba(255, 255, 255, 0.76);
  border: 2rpx solid rgba(32, 43, 68, 0.14);
  border-radius: 16rpx;
  font-size: 26rpx;
  font-weight: 760;
}

.chat-input-bar {
  display: flex;
  gap: 20rpx;
  margin-top: 24rpx;
  align-items: center;
}

.chat-input {
  flex: 1;
  min-height: 88rpx;
  padding: 0 26rpx;
  background: rgba(238, 244, 255, 0.68);
  border: 2rpx solid rgba(32, 43, 68, 0.14);
  border-radius: 10rpx;
  font-size: 30rpx;
}

.send-btn {
  min-width: 160rpx;
  min-height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #fff;
  background: #1c4fb7;
  border-radius: 16rpx;
  font-weight: 760;
  font-size: 30rpx;
}

/* ===== Timeline Section ===== */
.timeline-section {
  position: relative;
  z-index: 1;
  padding: 0 32rpx 80rpx;
}

.timeline {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
  margin-top: 48rpx;
}

.timeline-item {
  padding: 36rpx;
  background: rgba(238, 244, 255, 0.62);
  border: 2rpx solid rgba(32, 43, 68, 0.14);
  border-radius: 16rpx;
}

.timeline-num {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 76rpx;
  height: 76rpx;
  color: #fff;
  background: #1c4fb7;
  border-radius: 10rpx;
  font-family: Georgia, "Times New Roman", serif;
  font-size: 32rpx;
  font-weight: 800;
}

.timeline-name {
  display: block;
  margin-top: 24rpx;
  font-size: 34rpx;
  font-weight: 700;
  color: #151821;
}

.timeline-desc {
  display: block;
  margin-top: 12rpx;
  font-size: 28rpx;
  color: #7d8798;
  line-height: 1.5;
}

/* ===== Footer ===== */
.footer-space {
  height: 120rpx;
}
