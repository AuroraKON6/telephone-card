<!-- pages/index/index.wxml -->
<view class="page-root">
  <!-- Ambient beams -->
  <view class="ambient" aria-hidden="true">
    <view class="beam beam-a"></view>
    <view class="beam beam-b"></view>
    <view class="grain"></view>
  </view>

  <!-- ===== 顶部品牌区 ===== -->
  <header class="site-header">
    <view class="brand">
      <view class="brand-sigil">172</view>
      <view class="brand-text">
        <text class="brand-name">电话卡娘</text>
        <text class="brand-sub">Flow Atelier</text>
      </view>
    </view>
  </header>

  <!-- ===== 首屏导购区 ===== -->
  <section class="hero" id="top">
    <view class="hero-copy">
      <text class="overline">ANIME TELECOM CONCIERGE</text>
      <text class="hero-title">把流量卡办理，做成一次清爽的高级咨询。</text>
      <text class="hero-lead">电话卡娘会先看地区、年龄、首充与激活规则，再把合适套餐和咨询单交给客服 Agent 跟进。</text>
      <view class="hero-actions">
        <view class="button primary" bindtap="scrollToPlans">
          <text>查看精选套餐</text>
        </view>
        <view class="button quiet" bindtap="scrollToPrecheck">
          <text>先做办卡预检</text>
        </view>
      </view>
      <view class="hero-ledger">
        <view class="ledger-item">
          <text class="ledger-label">今日咨询</text>
          <text class="ledger-count">{{displayCount1}}</text>
          <text class="ledger-note">演示数据</text>
        </view>
        <view class="ledger-item">
          <text class="ledger-label">预检通过</text>
          <text class="ledger-count">{{displayCount2}}</text>
          <text class="ledger-note">规则命中</text>
        </view>
        <view class="ledger-item">
          <text class="ledger-label">待跟进</text>
          <text class="ledger-count">{{displayCount3}}</text>
          <text class="ledger-note">客服队列</text>
        </view>
      </view>
    </view>

    <!-- 看板娘展柜 -->
    <view class="mascot-stage">
      <view class="mascot-card">
        <view class="mascot-toolbar">
          <text class="toolbar-label">Live Concierge</text>
          <text class="toolbar-gaze">{{gazeLabel}}</text>
        </view>
        <view
          class="mascot-portrait {{mascotTap ? 'mascot-tap' : ''}}"
          id="mascotPortrait"
          bindtap="onMascotTap"
          bindtouchstart="onMascotTouchStart"
          bindtouchmove="onMascotTouchMove"
          bindtouchend="onMascotTouchEnd"
        >
          <view class="portrait-ring ring-one"></view>
          <view class="portrait-ring ring-two"></view>
          <view class="eye-glint eye-left" style="transform: translate({{lookX}}px, {{lookY}}px)"></view>
          <view class="eye-glint eye-right" style="transform: translate({{lookX}}px, {{lookY}}px)"></view>
          <!-- 表情叠加层 -->
          <view class="expression-layer" style="transform: translate({{exprX}}px, {{exprY}}px)">
            <view class="face-brow brow-left {{emotion}}"></view>
            <view class="face-brow brow-right {{emotion}}"></view>
            <view class="face-mouth {{emotion}}"></view>
            <view class="blush blush-left {{emotion}}"></view>
            <view class="blush blush-right {{emotion}}"></view>
            <view class="anger-mark {{emotion}}">
              <view class="anger-i anger-i1"></view>
              <view class="anger-i anger-i2"></view>
              <view class="anger-i anger-i3"></view>
              <view class="anger-i anger-i4"></view>
            </view>
            <view class="mood-sparkle sparkle-a {{emotion}}"></view>
            <view class="mood-sparkle sparkle-b {{emotion}}"></view>
            <view class="mood-sparkle sparkle-c {{emotion}}"></view>
          </view>
          <image src="/assets/mascot-front.png" mode="aspectFit" class="mascot-img" style="transform: translate({{imgX}}px, {{imgY}}px)"></image>
        </view>
        <view class="mascot-dialog">
          <view class="pulse-dot"></view>
          <text class="dialog-text">{{mascotLine}}</text>
        </view>
      </view>

      <view class="floating-note note-plan">
        <text class="note-label">推荐套餐</text>
        <text class="note-value">180G / 39元</text>
      </view>
      <view class="floating-note note-rule">
        <text class="note-label">规则预检</text>
        <text class="note-value">地区先查</text>
      </view>
    </view>
  </section>

  <!-- ===== 套餐卡片筛选 ===== -->
  <section class="plans-section" id="plans">
    <view class="section-heading">
      <text class="overline">PLAN COLLECTION</text>
      <text class="section-title">精选套餐陈列室</text>
      <text class="section-desc">这里保留真实 API 接入前的可替换展示位。价格、禁发区和首充规则上线时以 172 后台为准。</text>
    </view>
    <view class="segment-control">
      <view
        wx:for="{{filters}}"
        wx:key="value"
        class="seg-btn {{activeFilter === item.value ? 'active' : ''}}"
        data-filter="{{item.value}}"
        bindtap="onFilterTap"
      >
        <text>{{item.label}}</text>
      </view>
    </view>
    <view class="plan-gallery">
      <view
        wx:for="{{filteredPlans}}"
        wx:key="id"
        class="plan-card plan-tone-{{item.tone}}"
      >
        <view class="plan-label">{{item.tag}}</view>
        <text class="plan-name">{{item.name}}</text>
        <text class="plan-fit">{{item.summary}}</text>
        <view class="plan-price">
          <text class="price-num">{{item.monthlyPrice}}</text>
          <text class="price-unit">元 / 月起</text>
        </view>
        <view class="plan-specs">
          <view class="spec-row">
            <text class="spec-key">月流量</text>
            <text class="spec-val">{{item.monthlyData}}</text>
          </view>
          <view class="spec-row">
            <text class="spec-key">运营商</text>
            <text class="spec-val">{{item.carrier}}</text>
          </view>
          <view class="spec-row">
            <text class="spec-key">提醒</text>
            <text class="spec-val">{{item.tip}}</text>
          </view>
        </view>
      </view>
    </view>
  </section>

  <!-- ===== 办卡预检 ===== -->
  <section class="precheck-section" id="precheck">
    <view class="precheck-panel">
      <view class="section-heading compact">
        <text class="overline">PRECHECK RITUAL</text>
        <text class="section-title">办卡预检</text>
        <text class="section-desc">先判断高风险条件，再进入客服沟通。</text>
      </view>
      <view class="precheck-form">
        <view class="form-field">
          <text class="field-label">所在地区</text>
          <input
            class="field-input"
            placeholder="例如：广东深圳"
            value="{{city}}"
            bindinput="onCityInput"
          />
        </view>
        <view class="form-field">
          <text class="field-label">实名年龄</text>
          <input
            class="field-input"
            type="number"
            placeholder="例如：28"
            value="{{age}}"
            bindinput="onAgeInput"
          />
        </view>
        <view class="form-field">
          <text class="field-label">月预算</text>
          <picker bindchange="onBudgetChange" value="{{budgetIndex}}" range="{{budgetOptions}}" range-key="label">
            <view class="field-input picker-display">
              <text>{{budgetOptions[budgetIndex].label}}</text>
              <text class="picker-arrow">▾</text>
            </view>
          </picker>
        </view>
        <view class="form-field">
          <text class="field-label">使用场景</text>
          <picker bindchange="onNeedChange" value="{{needIndex}}" range="{{needOptions}}" range-key="label">
            <view class="field-input picker-display">
              <text>{{needOptions[needIndex].label}}</text>
              <text class="picker-arrow">▾</text>
            </view>
          </picker>
        </view>
      </view>
      <view class="precheck-result {{precheckStatus}}">
        <text class="result-title">{{precheckTitle}}</text>
        <text class="result-desc">{{precheckDesc}}</text>
      </view>
    </view>
  </section>

  <!-- ===== 客服 Agent 咨询 ===== -->
  <section class="agent-section" id="agent">
    <view class="agent-panel">
      <view class="section-heading compact">
        <text class="overline">SERVICE AGENT</text>
        <text class="section-title">客服 Agent 咨询台</text>
        <text class="section-desc">演示版会在本地生成回复，后续可接真实客服系统。</text>
      </view>
      <scroll-view class="chat-log" scroll-y scroll-into-view="{{chatScrollTarget}}" enhanced show-scrollbar="{{false}}">
        <view
          wx:for="{{messages}}"
          wx:key="id"
          class="message {{item.role}}"
          id="msg-{{item.id}}"
        >
          <text>{{item.text}}</text>
        </view>
      </scroll-view>
      <view class="quick-replies">
        <view
          wx:for="{{quickReplies}}"
          wx:key="*this"
          class="quick-btn"
          bindtap="onQuickReply"
          data-text="{{item}}"
        >
          <text>{{item}}</text>
        </view>
      </view>
      <view class="chat-input-bar">
        <input
          class="chat-input"
          placeholder="输入你的咨询需求"
          value="{{chatDraft}}"
          bindinput="onChatInput"
          bindconfirm="onChatSend"
          confirm-type="send"
        />
        <view class="send-btn" bindtap="onChatSend">
          <text>发送</text>
        </view>
      </view>
    </view>
  </section>

  <!-- ===== 办理流程 ===== -->
  <section class="timeline-section" id="timeline">
    <view class="section-heading">
      <text class="overline">ORDER PATH</text>
      <text class="section-title">从看套餐到交客服</text>
    </view>
    <view class="timeline">
      <view
        wx:for="{{orderSteps}}"
        wx:key="num"
        class="timeline-item"
      >
        <view class="timeline-num">{{item.num}}</view>
        <text class="timeline-name">{{item.name}}</text>
        <text class="timeline-desc">{{item.desc}}</text>
      </view>
    </view>
  </section>

  <!-- 底部留白 -->
  <view class="footer-space"></view>
</view>
